{
  "transpiler": {
    "command": [
      "../grand-transpiler",
      "--source-language",
      "{source_language}",
      "--target-language",
      "{target_language}",
      "--input",
      "{input}",
      "--output",
      "{output}"
    ]
  },

  "languages": ["c#", "typescript", "java"],

  "transpilation_timeout": 120,
  "build_timeout": 120,
  "execution_timeout": 30,

  "comparison": {
    "normalize_line_endings": true,
    "strip_trailing_whitespace": false,
    "strip_outer_whitespace": false
  },

  "language_commands": {
    "c#": {
      "extension": ".cs",
      "build": null,
      "run": ["dotnet-script", "{source}"]
    },

    "typescript": {
      "extension": ".ts",
      "build": null,
      "run": ["npx", "tsx", "{source}"]
    },

    "java": {
      "extension": ".java",
      "build": ["javac", "-d", "{output_dir}", "{source}"],
      "run": ["java", "-cp", "{output_dir}", "{class_name}"]
    }
  },

  "programs": {
    "numberOfSteps": {
      "files": {
        "c#": "C#/numberOfSteps.cs",
        "java": "Java/numberOfSteps.java",
        "typescript": "Typescript/numberOfSteps.ts"
      },
      "outputs": "results",
      "inputs": [["3"], ["5"], ["6"]]
    },
    "fibonacci": {
      "files": {
        "c#": "C#/fibonacci.cs",
        "java": "Java/fibonacci.java",
        "typescript": "Typescript/fibonacci.ts"
      },
      "outputs": "results",
      "inputs": [["0"], ["1"], ["2"], ["10"], ["30"]]
    },
    "fizzbuzz": {
      "files": {
        "c#": "C#/fizzbuzz.cs",
        "java": "Java/fizzbuzz.java",
        "typescript": "Typescript/fizzbuzz.ts"
      },
      "outputs": "results",
      "inputs": [["1"], ["3"], ["5"], ["7"], ["15"]]
    },
    "happyNumber": {
      "files": {
        "c#": "C#/happyNumber.cs",
        "java": "Java/happyNumber.java",
        "typescript": "Typescript/happyNumber.ts"
      },
      "outputs": "results",
      "inputs": [["1"], ["2"], ["4"], ["7"], ["19"]]
    },
    "subtractProductAndSum": {
      "files": {
        "c#": "C#/subtractProductAndSum.cs",
        "java": "Java/subtractProductAndSum.java",
        "typescript": "Typescript/subtractProductAndSum.ts"
      },
      "outputs": "results",
      "inputs": [["1"], ["10"], ["234"], ["4421"], ["100000"]]
    }
  }
}
